# Multi-stage: build console-v2 from TypeScript sources, then install the
# Python backoffice that serves the baked static assets.
FROM node:22-bookworm-slim AS console_build

WORKDIR /src/console_frontend
COPY console_frontend/package.json console_frontend/package-lock.json ./
RUN npm ci
COPY console_frontend/ ./
RUN npm run build

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AI_OPS_BACKOFFICE_HOST=0.0.0.0 \
    AI_OPS_BACKOFFICE_PORT=8080 \
    RAG_DATA_DIR=/app/data

WORKDIR /app

COPY agent_service/pyproject.toml agent_service/README.md ./agent_service/
COPY agent_service/src ./agent_service/src
COPY --from=console_build /src/agent_service/src/ai_ops_backoffice/static/console-v2 \
    ./agent_service/src/ai_ops_backoffice/static/console-v2
COPY data ./data

RUN pip install --no-cache-dir "./agent_service[firestore,portal]"

RUN mkdir -p /app/data/index \
    && chown -R 65532:65532 /app/data

USER 65532:65532

EXPOSE 8080

CMD ["python", "-m", "ai_ops_backoffice.main"]
