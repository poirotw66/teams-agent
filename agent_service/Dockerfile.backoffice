# Python Backoffice runtime. Serves the committed console-v2 static artifact
# (kept fresh by scripts/sync_console_v2.py --check in CI). Independent UI
# images build from console_frontend/Dockerfile; this image stays Python-only.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/app/.venv \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_NO_CACHE=1 \
    PATH=/app/.venv/bin:$PATH \
    AI_OPS_BACKOFFICE_HOST=0.0.0.0 \
    AI_OPS_BACKOFFICE_PORT=8080 \
    RAG_DATA_DIR=/app/data

WORKDIR /app

RUN pip install --no-cache-dir uv==0.8.15
COPY agent_service/pyproject.toml agent_service/uv.lock agent_service/README.md ./agent_service/
# Firestore/storage only. Portal PDF extras are not required for Backoffice API;
# portal package modules remain importable from the installed source tree.
RUN uv sync \
    --project agent_service \
    --frozen \
    --no-dev \
    --no-install-project \
    --extra firestore

COPY agent_service/src ./agent_service/src
RUN uv sync \
    --project agent_service \
    --frozen \
    --no-dev \
    --extra firestore

COPY data/ops ./data/ops
RUN mkdir -p /app/data/index \
    && chown -R 65532:65532 /app/data

USER 65532:65532

EXPOSE 8080

CMD ["python", "-m", "ai_ops_backoffice.main"]
