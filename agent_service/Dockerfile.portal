# Knowledge Portal API for Cloud Run (original dual-write + SourceRecord publish).
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/app/.venv \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_NO_CACHE=1 \
    PATH=/app/.venv/bin:$PATH \
    KNOWLEDGE_PORTAL_HOST=0.0.0.0 \
    KNOWLEDGE_PORTAL_PORT=8080 \
    KNOWLEDGE_PORTAL_DATA_DIR=/app/data \
    RAG_DATA_DIR=/app/data

WORKDIR /app

RUN pip install --no-cache-dir uv==0.8.15
COPY agent_service/pyproject.toml agent_service/uv.lock agent_service/README.md ./agent_service/
RUN uv sync \
    --project agent_service \
    --frozen \
    --no-dev \
    --no-install-project \
    --extra firestore \
    --extra portal

COPY agent_service/src ./agent_service/src
RUN uv sync \
    --project agent_service \
    --frozen \
    --no-dev \
    --extra firestore \
    --extra portal

RUN mkdir -p /app/data/releases /app/data/portal_state /app/data/portal_drafts \
    && chown -R 65532:65532 /app/data

USER 65532:65532

EXPOSE 8080

CMD ["python", "-m", "knowledge_portal.main"]
