# Knowledge Portal API for Cloud Run (original dual-write + SourceRecord publish).
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    KNOWLEDGE_PORTAL_HOST=0.0.0.0 \
    KNOWLEDGE_PORTAL_PORT=8080 \
    KNOWLEDGE_PORTAL_DATA_DIR=/app/data \
    RAG_DATA_DIR=/app/data

WORKDIR /app

COPY agent_service/pyproject.toml agent_service/README.md ./agent_service/
COPY agent_service/src ./agent_service/src
COPY data ./data

RUN pip install --no-cache-dir "./agent_service[firestore,portal]" \
    && mkdir -p /app/data/releases /app/data/portal_state /app/data/portal_drafts \
    && chown -R 65532:65532 /app/data

USER 65532:65532

EXPOSE 8080

CMD ["python", "-m", "knowledge_portal.main"]
