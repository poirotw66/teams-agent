HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Path is relative to agent_service/ when running locally.
RAG_DATA_DIR=../data
RAG_INDEX_PATH=../data/index/chunks.json
RAG_AUTO_BUILD_INDEX=true

# RAG retrieval / relevance grading (keep lightweight).
# Examples:
# RAG_MODEL=openai:gpt-4.1-mini
# RAG_MODEL=google_genai:gemini-3.5-flash-lite
RAG_MODEL=

# Main agentic LLM: extractor, handoff router, ticket selector.
# Falls back to RAG_MODEL when unset.
# Examples:
# AGENT_MODEL=openai:gpt-4.1-mini
# AGENT_MODEL=google_genai:gemini-3.7-flash
AGENT_MODEL=

# Optional semantic retrieval. Without this, the service uses local Chinese-aware BM25.
# Examples:
# RAG_EMBEDDING_MODEL=openai:text-embedding-3-small
# RAG_EMBEDDING_MODEL=google_genai:gemini-embedding-2
RAG_EMBEDDING_MODEL=

RAG_TOP_K=4
RAG_MIN_SCORE=0.08
RAG_MAX_REWRITES=1
RAG_MAX_IMAGES=2
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120

# Optional comma-separated tenant allowlist.
RAG_ALLOWED_TENANTS=

# Optional base URL for clickable source links.
RAG_SOURCE_BASE_URL=

# Optional bearer auth: /agent/chat and /retrieval/search require this token.
AGENT_SERVICE_TOKEN=

# Knowledge release loading for Agent Service.
# AUTO     = use portal active release when present, otherwise bundled RAG_INDEX_PATH
# PORTAL   = require portal release index (Cloud Run after portal handoff)
# BUNDLED  = always use RAG_INDEX_PATH from the container image
KNOWLEDGE_RELEASE_MODE=AUTO
KNOWLEDGE_RELEASE_DIR=../data/releases
# KNOWLEDGE_ACTIVE_RELEASE_ID=release-abc123

# --- Issue / cost controls (spec §4.2, §6.3, §16) ---
# Max independent issues extracted from one Teams message. Default 3,
# valid range 1-5.
MAX_ISSUES_PER_MESSAGE=3
# Max follow-up questions asked per issue when info is missing. Default 2,
# valid range 1-3.
MAX_MISSING_INFO_PER_ISSUE=2
# 同一個未完成問題最多追問幾輪；達上限後以現有資訊檢索／轉工單。
MAX_CLARIFICATION_ROUNDS=2
# Max prior messages loaded into workflow context per request. Default 10,
# valid range 0-50.
MAX_HISTORY_MESSAGES=10
# Max prior conversation rounds considered "recent" (spec §10.2). Default
# 5, valid range 1-20.
CONVERSATION_HISTORY_ROUNDS=5
# Hours of inactivity before a conversation is considered expired and a new
# one is started (spec §10.2). Default 24, valid range 1-168 (one week).
CONVERSATION_TIMEOUT_HOURS=24
# Firestore TTL retention is separate from the 24-hour conversation session.
CONVERSATION_RETENTION_DAYS=730
# Hard ceiling on LLM calls per /agent/chat request, across the Issue
# Extractor and every Knowledge Service call. Default 5, valid range 1-20.
MAX_LLM_CALLS_PER_REQUEST=5
# Max query-rewrite attempts during Hybrid RAG retrieval per issue. Default
# is whatever RAG_MAX_REWRITES above resolves to (1), valid range 0-3.
MAX_RETRIEVAL_REWRITES=1

# --- Knowledge Service (spec §8) ---
# HYBRID (default) uses the existing BM25 + embedding retrieval below.
# GEMINI_FILE_SEARCH selects the spike-only GeminiFileSearchKnowledgeService
# (see docs/gemini-file-search-spike.md) — spec §8.3/§18.7: do not set this
# in production until an A/B test proves it out; requires the `spike` extra
# (`uv sync --extra spike`) and GOOGLE_API_KEY/GEMINI_API_KEY.
KNOWLEDGE_SERVICE_MODE=HYBRID
# Required only when KNOWLEDGE_SERVICE_MODE=GEMINI_FILE_SEARCH: the Gemini
# File Search store name/ID to query.
GEMINI_FILE_SEARCH_STORE=
# File Search uses a native Gemini model name, separate from RAG_MODEL's
# provider-prefixed LangChain syntax.
GEMINI_FILE_SEARCH_MODEL=gemini-2.5-flash
# Keep true for configured shared/production environments. Set false only for
# a local evaluation store whose legacy uploads have no allowed_groups metadata;
# the service logs a warning because all store documents become visible. When
# this store field is left blank, start.sh recognizes this value as the copied
# template default and uses false for its localhost-only legacy-store fallback;
# set GEMINI_FILE_SEARCH_ENFORCE_ACL=true in the shell to override it.
GEMINI_FILE_SEARCH_ENFORCE_ACL=true
# MEMORY for local development. Cloud Run uses FIRESTORE so all instances
# observe the same selection made in Playground.
KNOWLEDGE_BACKEND_STATE_MODE=MEMORY
KNOWLEDGE_BACKEND_STATE_COLLECTION=runtime_config

# --- Ticket Service (spec §11) ---
# DISABLED (default): "create/query ticket" issues degrade to a clear
# error instead of calling out. HTTP: calls an internal ticketing API.
TICKET_SERVICE_MODE=DISABLED
# Required when TICKET_SERVICE_MODE=HTTP; must be an http(s) URL.
TICKET_SERVICE_BASE_URL=https://ticketing.internal.example.com
# Optional bearer token for the ticket API. Store the real value only in
# Secret Manager / .env, never in Git.
TICKET_SERVICE_TOKEN=replace-with-an-internal-service-token
# Timeout for calls to the ticket API. Default 10.0, valid range 1-60.
TICKET_SERVICE_TIMEOUT_SECONDS=10.0

# --- Conversation Repository (spec §10) ---
# MEMORY (default): in-process, lost on restart, fine for local dev/tests.
# FILE: JSON-file-backed, persists across restarts of the SAME process on
# the SAME disk.
# FIRESTORE: managed Google Cloud Firestore — the only mode that survives
# Cloud Run scale-to-zero and multi-instance routing, and therefore what
# deploy/deploy-gcp.sh sets in production. Requires the 'firestore' extra:
#   uv pip install '.[firestore]'
CONVERSATION_REPOSITORY_MODE=MEMORY
# Only used when CONVERSATION_REPOSITORY_MODE=FILE. Defaults to
# <RAG_DATA_DIR>/conversations. May contain user message text — never
# commit its contents (see .gitignore: data/conversations/ is ignored).
CONVERSATION_STORE_PATH=../data/conversations
# Only used when CONVERSATION_REPOSITORY_MODE=FIRESTORE. Project and
# database are normally left unset: Application Default Credentials
# resolve them to the running service's own project and the (default)
# database, which is what Cloud Run wants. Set them only to point at
# another project/database (e.g. a shared dev store).
# CONVERSATION_FIRESTORE_PROJECT=itr-aimasteryhub-lab
# CONVERSATION_FIRESTORE_DATABASE=teams-agent
# Root collection name. The repository also uses <name>_keys for the
# isolation-key index and a `messages` subcollection per conversation;
# all three need a TTL policy on `expiresAt` (deploy/deploy-gcp.sh sets
# them up). Must not contain '/'.
CONVERSATION_FIRESTORE_COLLECTION=conversations

# --- Human handoff (phase 2) ---
# MEMORY is suited to tests/local demos; FILE persists on one local disk;
# FIRESTORE supports Cloud Run restarts and multiple instances.
HANDOFF_REPOSITORY_MODE=MEMORY
# Used only in FILE mode. Defaults to <RAG_DATA_DIR>/handoffs.
HANDOFF_STORE_PATH=../data/handoffs
# Optional in FIRESTORE mode; leave project/database blank to use ADC defaults.
# HANDOFF_FIRESTORE_PROJECT=itr-aimasteryhub-lab
# HANDOFF_FIRESTORE_DATABASE=teams-agent
# Root collection ID for handoff records. Must not contain '/'.
HANDOFF_FIRESTORE_COLLECTION=handoffs
# Demo handoffs expire after this many hours unless acted on.
HANDOFF_DEMO_TIMEOUT_HOURS=24
# Persisted handoff records are eligible for deletion after this many days.
HANDOFF_RETENTION_DAYS=730

# --- FAQ (spec §7) ---
# LEGACY_JSON uses the bootstrap file below. GOVERNED reads only immutable
# ACTIVE versions from the shared Backoffice store and applies user groups.
FAQ_RUNTIME_MODE=LEGACY_JSON
# Path to the legacy FAQ configuration file (spec §7.2). Defaults to
# <RAG_DATA_DIR>/faq.json. This file IS tracked in Git (unlike the rest of
# data/) because FAQ entries are configuration, not corpus content — see
# the .gitignore comment.
FAQ_PATH=../data/faq.json
# Governed local/LAB mode. Cloud Run must use FIRESTORE so all instances see
# activation, rollback, and emergency disable without restart.
AI_OPS_FAQ_STORE_MODE=FILE
AI_OPS_FAQ_STORE_PATH=../data/ops/phase2/faqs.json
# Optional in FIRESTORE mode; ADC resolves project/default database when blank.
# AI_OPS_FAQ_FIRESTORE_PROJECT=itr-aimasteryhub-lab
# AI_OPS_FAQ_FIRESTORE_DATABASE=(default)
AI_OPS_FAQ_FIRESTORE_COLLECTION_PREFIX=ai_ops_faq

# --- Feedback (spec §14) ---
# When true (default), /agent/chat marks issue results as feedback-eligible
# and Teams shows 👍/👎 buttons; POST /feedback structured-logs each rating.
FEEDBACK_ENABLED=true

# --- Feedback (spec §14) ---
# FEEDBACK_ENABLED=true

# --- Cost visibility ---
# When true (default), each /agent/chat response includes estimatedCostUsd for
# the Teams UI to render as a per-turn cost footer.
# SHOW_TURN_COST=true
# Playground channel (channel=playground) hides the footer by default; cost is
# still written to structured logs and usage.recorded ops events.
# SHOW_TURN_COST_PLAYGROUND=false
# USD to TWD rate for the per-turn cost footer (queried 2026-08-31).
# USD_TWD_EXCHANGE_RATE=31.70

# --- Knowledge Operations Portal (local dev) ---
# KNOWLEDGE_PORTAL_PORT=8090
# KNOWLEDGE_PORTAL_REPOSITORY_MODE=FILE
# KNOWLEDGE_PORTAL_STATE_PATH=../data/portal_state/portal_state.json
# KNOWLEDGE_PORTAL_RELEASE_DIR=../data/releases
# KNOWLEDGE_PORTAL_RELAXED_WORKFLOW=true
# KNOWLEDGE_PORTAL_REQUIRE_DUAL_APPROVAL=false
# Set KNOWLEDGE_PORTAL_RELAXED_WORKFLOW=false for enterprise gates (3 test cases, no self-review for reviewers).
# KNOWLEDGE_PORTAL_AUTH_MODE=HEADER
# KNOWLEDGE_PORTAL_AUTH_MODE=ENTRA
# KNOWLEDGE_PORTAL_ENTRA_TENANT_ID=
# KNOWLEDGE_PORTAL_ENTRA_CLIENT_ID=
# KNOWLEDGE_PORTAL_AGENT_API_URL=http://localhost:8000
