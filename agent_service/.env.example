HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Path is relative to agent_service/ when running locally.
RAG_DATA_DIR=../data
RAG_INDEX_PATH=../data/index/chunks.json
RAG_AUTO_BUILD_INDEX=true

# Leave empty for deterministic local extractive mode.
# Examples:
# RAG_MODEL=openai:gpt-4.1-mini
# RAG_MODEL=google_genai:gemini-3.5-flash-lite
RAG_MODEL=

# Optional semantic retrieval. Without this, the service uses local Chinese-aware BM25.
# Examples:
# RAG_EMBEDDING_MODEL=openai:text-embedding-3-small
# RAG_EMBEDDING_MODEL=google_genai:gemini-embedding-2
RAG_EMBEDDING_MODEL=

RAG_TOP_K=4
RAG_MIN_SCORE=0.08
RAG_MAX_REWRITES=1
RAG_MAX_IMAGES=2
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120

# Optional comma-separated tenant allowlist.
RAG_ALLOWED_TENANTS=

# Optional base URL for clickable source links.
RAG_SOURCE_BASE_URL=

# When set, /agent/chat and /retrieval/search require this Bearer token.
AGENT_SERVICE_TOKEN=

# --- Issue / cost controls (spec §4.2, §6.3, §16) ---
# Max independent issues extracted from one Teams message. Default 3,
# valid range 1-5.
MAX_ISSUES_PER_MESSAGE=3
# Max follow-up questions asked per issue when info is missing. Default 2,
# valid range 1-3.
MAX_MISSING_INFO_PER_ISSUE=2
# Max prior messages loaded into workflow context per request. Default 10,
# valid range 0-50.
MAX_HISTORY_MESSAGES=10
# Max prior conversation rounds considered "recent" (spec §10.2). Default
# 5, valid range 1-20.
CONVERSATION_HISTORY_ROUNDS=5
# Hours of inactivity before a conversation is considered expired and a new
# one is started (spec §10.2). Default 24, valid range 1-168 (one week).
CONVERSATION_TIMEOUT_HOURS=24
# Hard ceiling on LLM calls per /agent/chat request, across the Issue
# Extractor and every Knowledge Service call. Default 5, valid range 1-20.
MAX_LLM_CALLS_PER_REQUEST=5
# Max query-rewrite attempts during Hybrid RAG retrieval per issue. Default
# is whatever RAG_MAX_REWRITES above resolves to (1), valid range 0-3.
MAX_RETRIEVAL_REWRITES=1

# --- Knowledge Service (spec §8) ---
# HYBRID (default) uses the existing BM25 + embedding retrieval below.
# GEMINI_FILE_SEARCH selects the spike-only GeminiFileSearchKnowledgeService
# (see docs/gemini-file-search-spike.md) — spec §8.3/§18.7: do not set this
# in production until an A/B test proves it out; requires the `spike` extra
# (`uv sync --extra spike`) and GOOGLE_API_KEY/GEMINI_API_KEY.
KNOWLEDGE_SERVICE_MODE=HYBRID
# Required only when KNOWLEDGE_SERVICE_MODE=GEMINI_FILE_SEARCH: the Gemini
# File Search store name/ID to query.
GEMINI_FILE_SEARCH_STORE=

# --- Ticket Service (spec §11) ---
# DISABLED (default): "create/query ticket" issues degrade to a clear
# error instead of calling out. HTTP: calls an internal ticketing API.
TICKET_SERVICE_MODE=DISABLED
# Required when TICKET_SERVICE_MODE=HTTP; must be an http(s) URL.
TICKET_SERVICE_BASE_URL=https://ticketing.internal.example.com
# Optional bearer token for the ticket API. Store the real value only in
# Secret Manager / .env, never in Git.
TICKET_SERVICE_TOKEN=replace-with-an-internal-service-token
# Timeout for calls to the ticket API. Default 10.0, valid range 1-60.
TICKET_SERVICE_TIMEOUT_SECONDS=10.0

# --- Conversation Repository (spec §10) ---
# MEMORY (default): in-process, lost on restart, fine for local dev/tests.
# FILE: JSON-file-backed, persists across restarts of the SAME process on
# the SAME disk.
# FIRESTORE: managed Google Cloud Firestore — the only mode that survives
# Cloud Run scale-to-zero and multi-instance routing, and therefore what
# deploy/deploy-gcp.sh sets in production. Requires the 'firestore' extra:
#   uv pip install '.[firestore]'
CONVERSATION_REPOSITORY_MODE=MEMORY
# Only used when CONVERSATION_REPOSITORY_MODE=FILE. Defaults to
# <RAG_DATA_DIR>/conversations. May contain user message text — never
# commit its contents (see .gitignore: data/conversations/ is ignored).
CONVERSATION_STORE_PATH=../data/conversations
# Only used when CONVERSATION_REPOSITORY_MODE=FIRESTORE. Project and
# database are normally left unset: Application Default Credentials
# resolve them to the running service's own project and the (default)
# database, which is what Cloud Run wants. Set them only to point at
# another project/database (e.g. a shared dev store).
# CONVERSATION_FIRESTORE_PROJECT=itr-aimasteryhub-lab
# CONVERSATION_FIRESTORE_DATABASE=teams-agent
# Root collection name. The repository also uses <name>_keys for the
# isolation-key index and a `messages` subcollection per conversation;
# all three need a TTL policy on `expiresAt` (deploy/deploy-gcp.sh sets
# them up). Must not contain '/'.
CONVERSATION_FIRESTORE_COLLECTION=conversations

# --- FAQ (spec §7) ---
# Path to the FAQ configuration file (spec §7.2). Defaults to
# <RAG_DATA_DIR>/faq.json. This file IS tracked in Git (unlike the rest of
# data/) because FAQ entries are configuration, not corpus content — see
# the .gitignore comment.
FAQ_PATH=../data/faq.json

# --- Feedback (spec §14) ---
# When true (default), /agent/chat marks issue results as feedback-eligible
# and Teams shows 👍/👎 buttons; POST /feedback structured-logs each rating.
FEEDBACK_ENABLED=true
