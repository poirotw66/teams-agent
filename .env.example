# Azure Bot / Entra application credentials.
# Copy this file to .env and replace the placeholders.
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=00000000-0000-0000-0000-000000000000
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=replace-with-the-client-secret-value
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=00000000-0000-0000-0000-000000000000

# Local default. Cloud Run and most container platforms inject PORT automatically.
PORT=3978
HOST=0.0.0.0
LOG_LEVEL=INFO

# Keep Echo mode until an independent Agent Gateway is available.
AGENT_MODE=echo

# Required only when AGENT_MODE=api.
AGENT_API_URL=https://agent-gateway.example.com/agent/chat
AGENT_API_TOKEN=replace-with-an-internal-service-token
AGENT_API_TIMEOUT_SECONDS=10

# Production Cloud Run service-to-service authentication.
# AGENT_API_AUTH_MODE=google_id_token
# AGENT_API_AUDIENCE=https://teams-rag-agent-xxxxx.asia-east1.run.app

# Required to show RAG source images in Teams Adaptive Cards. For local
# development, use the current Dev Tunnel base URL without /api/messages.
BOT_PUBLIC_BASE_URL=https://your-tunnel-3978.example.devtunnels.ms
RAG_ASSET_DIR=./data/assets
RAG_ASSET_SIGNING_KEY=replace-with-at-least-16-random-characters
RAG_ASSET_URL_TTL_SECONDS=3600
RAG_ASSET_MAX_DIMENSION=1024
RAG_ASSET_MAX_BYTES=1000000
