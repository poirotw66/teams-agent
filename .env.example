# Teams Adapter environment (`teams_agent`, built on the Microsoft Teams SDK
# and deployed as the public `teams-agent-adapter` Cloud Run service). Copy
# this file to `.env` at the project root and replace the placeholders.
#
# The LangGraph Agent Service (`agent_service`, deployed as the private
# `teams-rag-agent` Cloud Run service) has its own, separate env file:
# see agent_service/.env.example and `cp agent_service/.env.example
# agent_service/.env`. The two services are never configured from the same
# .env file, in local dev or in Cloud Run.
#
# Microsoft Teams SDK app credentials. These come from an Entra ID app
# registration plus a bot registration created in the Teams Developer Portal
# (https://dev.teams.microsoft.com) -- neither requires an Azure subscription
# or an Azure Bot Service resource. See docs/teams-app-setup.md.
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=replace-with-the-client-secret-value
TENANT_ID=00000000-0000-0000-0000-000000000000
# Use `entra` only when the public endpoint is driven by a remotely hosted
# Microsoft 365 Agents Playground. Real Teams traffic uses `botframework`.
TEAMS_INBOUND_AUTH_MODE=botframework

# LOCAL DEVELOPMENT ONLY. Skips Bot Framework JWT validation on
# POST /api/messages so the Teams SDK devtools can drive the adapter without
# credentials. Never set this in Cloud Run -- it leaves the endpoint open to
# anyone who can reach it.
# DANGEROUSLY_ALLOW_UNAUTHENTICATED_REQUESTS=true
# Optional only with the unsafe local flag above. Supplies the email missing
# from Agents Playground's mock user when testing the local Mock Ticket API.
# PLAYGROUND_TEST_USER_EMAIL=playground.user@example.test

# Local default. Cloud Run and most container platforms inject PORT
# automatically. There is no HOST setting: the Teams SDK's FastAPIAdapter
# always binds 0.0.0.0, which is what Cloud Run requires anyway.
PORT=3978
LOG_LEVEL=INFO

# Keep Echo mode until an independent Agent Gateway is available.
AGENT_MODE=echo

# Required only when AGENT_MODE=api.
AGENT_API_URL=https://agent-gateway.example.com/agent/chat
AGENT_API_TOKEN=replace-with-an-internal-service-token
AGENT_API_TIMEOUT_SECONDS=10

# Stream workflow progress ("正在檢索知識庫…") into Teams while the Agent
# Service runs, instead of leaving the user waiting for the finished answer.
# Only takes effect in 1:1 personal chats and only when AGENT_MODE=api:
# Teams refuses streamed messages in channels and group chats, where the
# adapter silently uses the normal single-reply path. Set to false to turn
# it off everywhere.
AGENT_STREAMING_ENABLED=true

# Production Cloud Run service-to-service authentication.
# AGENT_API_AUTH_MODE=google_id_token
# AGENT_API_AUDIENCE=https://teams-rag-agent-xxxxx.asia-east1.run.app

# Required to show RAG source images in Teams Adaptive Cards. For local
# development, use the current Dev Tunnel base URL without /api/messages.
# Agents Playground may instead use http://localhost:3978, but only together
# with DANGEROUSLY_ALLOW_UNAUTHENTICATED_REQUESTS=true.
BOT_PUBLIC_BASE_URL=https://your-tunnel-3978.example.devtunnels.ms
RAG_ASSET_DIR=./data/assets
RAG_ASSET_SIGNING_KEY=replace-with-at-least-16-random-characters
RAG_ASSET_URL_TTL_SECONDS=3600
RAG_ASSET_MAX_DIMENSION=1024
RAG_ASSET_MAX_BYTES=1000000

# User Directory Service (spec §12): resolves Teams/Entra users to an email
# when the Teams activity doesn't already carry one. disabled = no Graph
# calls, POC default, requires no Graph API permissions. graph = call
# Microsoft Graph GET /users/{id} using the app's own credentials
# (CLIENT_ID / CLIENT_SECRET / TENANT_ID above, app-only client credentials;
# needs the User.Read.All application permission with admin consent).
USER_DIRECTORY_MODE=disabled
# How long (seconds) a resolved email is cached in-process before the next
# lookup calls Microsoft Graph again. Only relevant when mode=graph.
USER_DIRECTORY_CACHE_TTL_SECONDS=300
