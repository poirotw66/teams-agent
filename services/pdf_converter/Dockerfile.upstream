# Full-capability image: build from poirotw66/pdf-to-markdown-converter.
# Requires network at build time and GOOGLE_API_KEY at runtime.
ARG UPSTREAM_REF=main
FROM python:3.11-slim

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    curl \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

RUN git clone --depth 1 --branch "${UPSTREAM_REF}" \
    https://github.com/poirotw66/pdf-to-markdown-converter.git /src \
    && cp -a /src/. /app/ \
    && rm -rf /src

RUN uv sync --frozen || uv sync

ENV PORT=8080
ENV API_HOST=0.0.0.0
ENV API_PORT=8080
EXPOSE 8080
CMD ["sh", "-c", "uv run uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
