# Copy to infra/terraform/terraform.tfvars for POC import only.
# Do NOT use this file's backend or allow_latest_image_tags for new projects.

project_id = "itr-aimasteryhub-lab"
region     = "asia-east1"

bot_client_id = "REPLACE_WITH_ENTRA_CLIENT_ID"
bot_tenant_id = "REPLACE_WITH_ENTRA_TENANT_ID"

# Import-only escape hatch while images stay on :latest in live POC.
allow_latest_image_tags = true

# Required for zero-diff import against the existing Adapter deployment:
# adapter_public_base_url = "https://teams-agent-adapter-jt7pjdeeoa-de.a.run.app"

# Optional explicit pins during import (otherwise :latest via allow_latest_image_tags):
