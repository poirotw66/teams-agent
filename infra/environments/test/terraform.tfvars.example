# Copy to infra/terraform/terraform.tfvars for a new test project.
# Bootstrap uses deployment_phase — do not require images on the first apply.

project_id = "your-test-project-id"
region     = "asia-east1"
environment_name = "test"

bot_client_id = "00000000-0000-0000-0000-000000000000"
bot_tenant_id = "00000000-0000-0000-0000-000000000000"

allow_latest_image_tags = false

# Step 1 — Prepare Environment (no Cloud Run, no images required):
deployment_phase = "prepare"

# Before activate/full, write explicit Vertex project + approved locations.
# Do not copy project_id into vertex_ai_project. Do not write "global".
# vertex_ai_project            = "your-vertex-project"
# vertex_ai_chat_location      = "bu-approved-region"
# vertex_ai_embedding_location = "bu-approved-region"
# vertex_ai_pdf_location       = "bu-approved-region"  # required when Vision/converter is on

# Step 4 — Activate Services (after secrets + BUILD_ONLY=1 release-gcp.sh):
# deployment_phase = "activate"
# agent_image      = "asia-east1-docker.pkg.dev/your-test-project-id/teams-agent/teams-rag-agent:REPLACE_WITH_GIT_SHA"
# adapter_image    = "asia-east1-docker.pkg.dev/your-test-project-id/teams-agent/teams-agent-adapter:REPLACE_WITH_GIT_SHA"
# backoffice_image = "asia-east1-docker.pkg.dev/your-test-project-id/teams-agent/teams-ai-ops-backoffice:REPLACE_WITH_GIT_SHA"
# portal_image     = "asia-east1-docker.pkg.dev/your-test-project-id/teams-agent/teams-knowledge-portal:REPLACE_WITH_GIT_SHA"
# enable_pdf_converter = true
# pdf_converter_image  = "asia-east1-docker.pkg.dev/your-test-project-id/teams-agent/teams-pdf-converter:REPLACE_WITH_GIT_SHA"
# pdf_converter_existing_url = "https://teams-pdf-converter-xxxxx.a.run.app"
# portal_pdf_converter_engine = "legacy_text"  # only to park Vision explicitly

# Step 5 — set after activate once Adapter URL is known:
# adapter_public_base_url = "https://teams-agent-adapter-xxxxx.a.run.app"

# Optional external Portal URL override. Terraform deploys the internal Portal.
# knowledge_portal_public_url = "https://knowledge-portal.test.example.com"
